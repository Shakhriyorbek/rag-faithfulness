# ============================================================
# SSH config for SZTE RGAI server access
# Place at:  Windows  C:\Users\<you>\.ssh\config
#            Linux/macOS  ~/.ssh/config
#
# Then a single command gets you a GPU shell:   ssh szte-gpu
#
# Verified 2026-07-26: key auth to the hop works; gpu1 = GPU1_PRIVATE_IP.
#
# 2026-08-13 — `ssh szte-gpu` now works DIRECTLY, including scp and git.
# Berend authorized the laptop key on the HOP only, so until this date the
# ProxyJump alias failed with `Permission denied (publickey)` and every file
# transfer had to be piped through the hop. Appending the laptop public key to
# gpu1:~/.ssh/authorized_keys fixed it. If it ever regresses, that file is
# where to look first.
#
# Also settled 2026-08-13: $HOME is NOT shared between hop and gpu1. Copying
# to the hop does nothing for gpu1 — do not rely on it.
#
# Deploy loop:  git push gpu1 main   (remote gpu1 -> szte-gpu:rag-faithfulness.git)
#               then `cd ~/rag-faithfulness && git pull` on gpu1.
# ============================================================
# ------------------------------------------------------------
# PLACEHOLDERS: this file is published in a public repository, so the
# real host details are redacted. Before use, substitute:
#     SZTE_HOP_IP      -> the RGAI entry host's public IP
#     GPU1_PRIVATE_IP  -> gpu1's private address, routable only from the hop
#     <your-username>  -> your SZTE account name
# Ask your supervisor for all three. Everything else here is accurate and
# was verified against the live hosts.
# ------------------------------------------------------------

# ── Hop / entry instance (jump host) ──
# Berend: "not primarily meant for conducting experiments" — it is an
# entry point only. Never compute here.
Host szte-hop
    HostName SZTE_HOP_IP
    User <your-username>
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3

# ── GPU server, reached THROUGH the hop:  ssh szte-gpu ──
#
# HostName MUST be the private IP, NOT the alias "gpu1".
#
# Berend defined the alias only inside the HOP's own ~/.ssh/config:
#     host gpu1
#       hostname GPU1_PRIVATE_IP
# So `ssh gpu1` works once you are already on the hop, because SSH reads
# that config. But ProxyJump connects with `ssh -W gpu1:22`, which does a
# literal DNS lookup and ignores Host aliases — giving:
#     channel 0: open failed: connect failed: Temporary failure in name resolution
# GPU1_PRIVATE_IP is private and routable only from the hop, which is
# precisely why the jump host exists.
Host szte-gpu
    HostName GPU1_PRIVATE_IP
    User <your-username>
    IdentityFile ~/.ssh/id_ed25519
    ProxyJump szte-hop
    ServerAliveInterval 60
    ServerAliveCountMax 3

# ── Connection multiplexing (Linux/macOS ONLY — do NOT use on Windows) ──
# The gateway rate-limits SSH: roughly 6 connections in a few minutes got
# the source IP temporarily blocked (TCP 22 went from open to refused).
# ControlMaster keeps ONE real TCP connection and multiplexes the rest, so
# repeated ssh/scp calls cost nothing.
#
# It needs Unix domain sockets and is NOT supported by Windows OpenSSH —
# enabling it there makes every connection fail. Uncomment on Linux/macOS:
#
# Host szte-*
#     ControlMaster auto
#     ControlPath ~/.ssh/cm-%r@%h:%p
#     ControlPersist 10m
