# Runtime artifacts
checkpoints/
outputs/
hf_cache/
*.pkl
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
ragfaith_env/

# Secrets — never commit API keys.
# Deliberately broad: a key pasted into an ad-hoc filename is the common
# accident, and `.env` + `*.key` alone did not cover key.txt.
.env
.env.*
*.key
*.pem
key*.txt
*key.txt
*secret*
*token*
.rag_env
credentials*

# OS
.DS_Store
Thumbs.db

# Node toolchain for paper/build_v*.js (installed 2026-08-30)
paper/node_modules/

# LaTeX build artifacts (paper/acl). The PDFs are committed deliberately so a
# reader of the repo can see the manuscript without a TeX install; the logs and
# aux files are not.
paper/acl/*.log
paper/acl/*.aux
paper/acl/*.blg
paper/acl/*.bbl
paper/acl/*.out
paper/acl/main-preprint.tex
paper/acl/main-8page-preprint.tex
